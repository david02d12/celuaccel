<?xml version="1.0" encoding="utf-8"?>
<!-- LayoutAnimation: aplica item_fade_in escalonadamente a todos los hijos de un RecyclerView
     Delay de 15% entre cada item = efecto stagger igual que el web -->
<layoutAnimation
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:animation="@anim/item_fade_in"
    android:animationOrder="normal"
    android:delay="15%"/>
