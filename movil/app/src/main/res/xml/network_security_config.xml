<?xml version="1.0" encoding="utf-8"?>
<!--
    ════════════════════════════════════════════════════════════════
    CONFIGURACIÓN DE SEGURIDAD DE RED — CeluAccel Android
    PRODUCCIÓN:  Solo HTTPS hacia el backend desplegado en la nube.
    ════════════════════════════════════════════════════════════════
-->
<network-security-config>

    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>